          "mathematical_connections": []
        },
        {
          "day": 1,
          "number": 2,
          "problem": "Suppose $f\\in C^2([-1,1])$ satisfies $f(-1)=f(1)=1$ and $\\int_{-1}^{1}f(t)\\,dt=0$. Establish $\\int_{-1}^{1}(f''(t))^2\\,dt\\ge15$ and describe precisely the equality cases.",
          "topics": [
            "Real Analysis",
            "Integral Inequalities"
          ],
          "problem_dna": [
            "am-gm"
          ],
          "source_url": "https://www.imc-math.org.uk/?item=prob2q&section=problems&year=2025",
          "statement_verified": true,
          "statement_form": "independently_reworded_equivalent_not_verbatim",
          "taxonomy_status": "provisional",
          "mathematical_connections": []
        },
        {
          "day": 1,
          "number": 3,
          "problem": "Among all symmetric rank-one matrices of size $2025\\times2025$ with every entry in $\\{-1,1\\}$, choose $A$ and $B$ independently and uniformly. Compute the probability of $AB=BA$.",
          "topics": [
            "Linear Algebra",
            "Probability"
          ],
          "problem_dna": [
            "counting"
          ],
          "source_url": "https://www.imc-math.org.uk/?item=prob3q&section=problems&year=2025",
          "statement_verified": true,
          "statement_form": "independently_reworded_equivalent_not_verbatim",
          "taxonomy_status": "provisional",
          "mathematical_connections": []
        },
        {
          "day": 1,
          "number": 4,
          "problem": "Fix an even positive integer $a$. Determine the real values of $x$ for which, simultaneously for all positive integers $b$, $\\left\\lfloor b^{a-1}\\sqrt[a]{b^a+x}\\right\\rfloor=b^a+\\left\\lfloor x/a\\right\\rfloor$. Here $\\lfloor t\\rfloor$ is the integer part of $t$.",
          "topics": [
            "Number Theory",
            "Floor Functions"
          ],
          "problem_dna": [
            "floor-blocks"
          ],
          "source_url": "https://www.imc-math.org.uk/?item=prob4q&section=problems&year=2025",
          "statement_verified": true,
          "statement_form": "independently_reworded_equivalent_not_verbatim",
          "taxonomy_status": "provisional",
          "mathematical_connections": []
        },
        {
          "day": 1,
          "number": 5,
          "problem": "Put $[n]=\\{1,\\ldots,n\\}$. For any self-map $\\tau:[n]\\to[n]$, define $\\operatorname{ord}(\\tau)$ as the cardinality of $\\{\\tau,\\tau^2,\\tau^3,\\ldots\\}$, with powers denoting composition. Let $f(n)$ be the largest such cardinality among permutations and $g(n)$ the largest among all self-maps. Show that for all sufficiently large $n$, $g(n)<f(n)+n^{0.501}$.",
          "topics": [
            "Combinatorics",
            "Finite Functions"
          ],
          "problem_dna": [
            "counting"
          ],
          "source_url": "https://www.imc-math.org.uk/?item=prob5q&section=problems&year=2025",

      "problems": [
        {
          "day": 1,
          "number": 1,
          "problem": "Let $P\\in\\mathbb R[x]$ have degree at least $2$, and for each real $t$ write $\\ell_t$ for the tangent to $y=P(x)$ at $(t,P(t))$. (a) Prove that $\\bigcup_{t\\in\\mathbb R}\\ell_t=\\mathbb R^2$ whenever $\\deg P$ is odd. (b) Decide whether an even-degree polynomial can also have tangents whose union covers the whole plane.",
          "topics": [
            "Geometry",
            "Polynomials"
          ],
          "problem_dna": [
            "polynomial-identity"
          ],
          "source_url": "https://www.imc-math.org.uk/?item=prob1q&section=problems&year=2025",
          "statement_verified": true,
          "statement_form": "independently_reworded_equivalent_not_verbatim",
